# 复制为 .env 后按需修改；不创建 .env 时使用同样的默认值。
PORT=8080
FRONTEND_DIR=../Online-Store-main
DB_PATH=./data/store.db
# 商城用户会话有效期（小时）
SESSION_TTL_HOURS=168
# 后台初始管理员：首次启动且邮箱不存在时创建；已有账号不会被改密码。
# ADMIN_PASSWORD 留空时生成 16 位随机密码，并只在启动日志打印一次。
ADMIN_EMAIL=admin@greenfarm.local
ADMIN_PASSWORD=admin12345
# 管理员会话有效期（小时）
ADMIN_SESSION_TTL_HOURS=12
# 生产环境 HTTPS 下改为 true
COOKIE_SECURE=false
# 可选：允许跨域携带 Cookie 的前端来源，如 http://localhost:5500
ALLOWED_ORIGIN=
APP_ENV=development
